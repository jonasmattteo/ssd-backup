#!/bin/zsh
# ============================================================================
#  ssd-backup – verschlüsseltes, versioniertes Backup einer externen SSD
#               nach pCloud (restic + rclone)
#
#  ssd-backup help        zeigt alle Befehle
# ============================================================================

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

CONF_DIR="$HOME/.config/ssd-backup"
SETTINGS="$CONF_DIR/settings.conf"
SOURCES_DIR="$CONF_DIR/sources"         # eine Unterordner pro Quelle (Platte/Ordner)
INCLUDE_FILE="$CONF_DIR/include.txt"    # nur noch für die Übernahme alter Einstellungen
EXCLUDE_FILE="$CONF_DIR/exclude.txt"
STATE_DIR="$HOME/Library/Application Support/ssd-backup"
STATUS_FILE="$STATE_DIR/status"
LOG_FILE="$HOME/Library/Logs/ssd-backup.log"
LOCK_DIR="$STATE_DIR/lock"

# Systemordner, die nie gesichert werden
SYSTEM_EXCLUDES=(
  ".Spotlight-V100" ".Trashes" ".fseventsd" ".TemporaryItems"
  ".DocumentRevisions-V100" ".restic-cache" ".DS_Store"
  "$HOME/restic-mount" "$HOME/Library/Caches" "$HOME/.Trash"
)
# zusätzlich, wenn eine Quelle die ganze interne Platte ("/") ist
ROOT_EXCLUDES=(/Volumes /System /dev /private/var/vm /private/var/folders /cores /Library/Caches)

# ---------------------------------------------------------------------------
#  Konfiguration (wird beim ersten Aufruf mit Standardwerten angelegt)
# ---------------------------------------------------------------------------
ensure_config() {
  mkdir -p "$CONF_DIR" "$STATE_DIR" "${LOG_FILE:h}"
  [[ -f "$SETTINGS" ]] || cat > "$SETTINGS" <<'EOF'
# Einstellungen für ssd-backup
SSD_NAME="MeineSSD"              # Name unter /Volumes/
RCLONE_REMOTE="pcloud"           # Name des rclone-Remotes
REPO_PATH="Backups/SSD"          # Ordner in pCloud
KEYCHAIN_SERVICE="restic-pcloud" # Schlüsselbund-Eintrag fürs Passwort

MIN_HOURS_BETWEEN=20             # Mindestabstand zwischen automatischen Backups
KEEP_DAILY=7                     # Aufbewahrung der Stände
KEEP_WEEKLY=4
KEEP_MONTHLY=12
KEEP_YEARLY=3
PRUNE_EVERY_DAYS=7               # alte Daten endgültig löschen
CHECK_EVERY_DAYS=30              # Integritätsprüfung
NOTIFICATIONS=1                  # macOS-Mitteilungen (0 = aus)
NOTIFY_PROGRESS=1                # zusätzlich bei 25/50/75 % (0 = aus)
RCLONE_CONNECTIONS=2             # gleichzeitige Uploads zu pCloud
PASSWORD_COMMAND=""              # leer = macOS-Schlüsselbund verwenden

# Zeitplan (nach Änderung: ssd-backup schedule apply)
RUN_ON_MOUNT=1                   # beim Einstecken der SSD starten
SCHEDULE="interval"              # interval | daily | none
INTERVAL_HOURS=1                 # bei interval: alle X Stunden versuchen
DAILY_TIME="03:00"               # bei daily: Uhrzeit
EOF
  # Standardwerte für Einstellungen, die in älteren settings.conf fehlen
  RUN_ON_MOUNT=1 SCHEDULE=interval INTERVAL_HOURS=1 DAILY_TIME="03:00"
  source "$SETTINGS"
  export RESTIC_REPOSITORY="rclone:${RCLONE_REMOTE}:${REPO_PATH}"
  export RESTIC_PASSWORD_COMMAND="${PASSWORD_COMMAND:-security find-generic-password -a $USER -s $KEYCHAIN_SERVICE -w}"
  migrate_sources

  # Cache auf der ersten angesteckten externen Quelle statt intern – ist keine
  # angesteckt (z. B. beim Durchstöbern), einen Cache im Library-Ordner verwenden
  export RESTIC_CACHE_DIR="$HOME/Library/Caches/ssd-backup-restic"
  local id
  for id in $(source_ids); do
    load_source "$id" || continue
    if src_external && src_present; then export RESTIC_CACHE_DIR="$SRC_ROOT/.restic-cache"; break; fi
  done
}

# ---------------------------------------------------------------------------
#  Quellen (Platten oder Ordner, die gesichert werden)
#    ~/.config/ssd-backup/sources/<id>/source.conf   NAME, ROOT, TAG, ENABLED
#                                    /include.txt, /exclude.txt
#    ~/Library/Application Support/ssd-backup/sources/<id>/   last_success, last_run(.json)
# ---------------------------------------------------------------------------
source_ids() {
  local d
  for d in "$SOURCES_DIR"/*(N/); do [[ -f "$d/source.conf" ]] && print -r -- "${d:t}"; done
}

load_source() {   # setzt SRC_ID, SRC_NAME, SRC_ROOT, SRC_TAG, SRC_ENABLED, SRC_INCLUDE, SRC_EXCLUDE, SRC_STATE
  local f="$SOURCES_DIR/$1/source.conf"
  [[ -n "$1" && -f "$f" ]] || return 1
  local NAME="" ROOT="" TAG="" ENABLED=1
  source "$f"
  SRC_ID=$1 SRC_NAME=${NAME:-$1} SRC_ROOT=$ROOT SRC_TAG=${TAG:-$1} SRC_ENABLED=${ENABLED:-1}
  SRC_INCLUDE="$SOURCES_DIR/$1/include.txt" SRC_EXCLUDE="$SOURCES_DIR/$1/exclude.txt"
  SRC_STATE="$STATE_DIR/sources/$1"
  mkdir -p "$SRC_STATE"
}

src_present()  { [[ -n "$SRC_ROOT" && -d "$SRC_ROOT" ]]; }
src_external() { [[ "$SRC_ROOT" == /Volumes/* ]]; }
src_kind()     { src_external && print -r -- "extern" || print -r -- "intern"; }

dq() { local v=${1//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\$/\\\$}; v=${v//\`/\\\`}; print -r -- "\"$v\""; }

write_source() {  # write_source ID NAME ROOT TAG [ENABLED]
  local dir="$SOURCES_DIR/$1"
  mkdir -p "$dir"
  {
    print "# Quelle für ssd-backup"
    print -r -- "NAME=$(dq "$2")"
    print -r -- "ROOT=$(dq "$3")"
    print -r -- "TAG=$(dq "$4")"
    print -r -- "ENABLED=${5:-1}"
  } > "$dir/source.conf"
  [[ -f "$dir/include.txt" ]] || cat > "$dir/include.txt" <<'EOF'
# Ordner, die gesichert werden – ein Ordner pro Zeile, relativ zur Quelle.
# Ist diese Liste leer, wird die GANZE Quelle gesichert.
# Beispiel:
#   Fotos
#   Projekte/2026
EOF
  [[ -f "$dir/exclude.txt" ]] || cat > "$dir/exclude.txt" <<'EOF'
# Ordner/Dateien, die NICHT gesichert werden – einer pro Zeile.
#   Ohne * ? [ ]  → Pfad relativ zur Quelle, z. B.:  Filme/Rohmaterial
#   Mit  * ? [ ]  → Muster, gilt überall, z. B.:  *.tmp   **/node_modules
# Tipp: Eine leere Datei ".nobackup" in einem Ordner schließt ihn ebenfalls aus.
EOF
}

slugify() {
  local s; s=$(print -r -- "$1" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || print -r -- "$1")
  s=$(print -r -- "$s" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  print -r -- "${s:-quelle}"
}

# Einrichtung aus der Version mit nur einer SSD übernehmen (einmalig)
migrate_sources() {
  [[ -d "$SOURCES_DIR" ]] && return
  mkdir -p "$SOURCES_DIR"
  [[ -n "$SSD_NAME" && "$SSD_NAME" != "MeineSSD" ]] || return
  local id; id=$(slugify "$SSD_NAME")
  # Stichwort "ssd" beibehalten, damit die bisherigen Stände weitergeführt werden
  write_source "$id" "$SSD_NAME" "/Volumes/$SSD_NAME" ssd
  [[ -f "$INCLUDE_FILE" ]] && mv "$INCLUDE_FILE" "$SOURCES_DIR/$id/include.txt"
  [[ -f "$EXCLUDE_FILE" ]] && mv "$EXCLUDE_FILE" "$SOURCES_DIR/$id/exclude.txt"
  mkdir -p "$STATE_DIR/sources/$id"
  local f; for f in last_success last_run last_run.json; do
    [[ -f "$STATE_DIR/$f" ]] && cp "$STATE_DIR/$f" "$STATE_DIR/sources/$id/$f"
  done
  log "Einstellungen übernommen: Quelle '$SSD_NAME' ($id)"
}

# Quelle für include/exclude wählen:  -s ID | --source ID, sonst die erste
select_source() {
  local want=""
  if [[ "$1" == (-s|--source) ]]; then want=$2; fi
  local -a ids; ids=($(source_ids))
  (( ${#ids} )) || { print "Noch keine Quelle eingerichtet – ssd-backup source add" >&2; return 1; }
  if [[ -n "$want" ]]; then
    load_source "$want" || {
      local id; for id in $ids; do load_source "$id" && [[ "$SRC_NAME" == "$want" ]] && return 0; done
      print "Unbekannte Quelle: $want  (ssd-backup sources)" >&2; return 1; }
  else
    load_source "${ids[1]}"
    (( ${#ids} > 1 )) && print "(Quelle: $SRC_NAME – andere mit -s ID wählen, siehe: ssd-backup sources)" >&2
  fi
  return 0
}

cmd_source() {
  local action=${1:-list}; (( $# )) && shift
  local id
  case $action in
    list|ls|"")
      local -a ids; ids=($(source_ids))
      (( ${#ids} )) || { print "Noch keine Quelle eingerichtet – ssd-backup source add"; return; }
      local st
      for id in $ids; do
        load_source "$id"
        st="nicht verfügbar"; src_present && { src_external && st="angesteckt" || st="vorhanden"; }
        (( SRC_ENABLED )) || st="$st, deaktiviert"
        printf "  %-18s %-22s %s  (%s, %s)\n" "$id" "$SRC_NAME" "$SRC_ROOT" "$(src_kind)" "$st"
      done ;;
    add)
      local dir=$1 name=$2
      if [[ -z "$dir" ]]; then
        dir=$(osascript -e 'POSIX path of (choose folder with prompt "Platte oder Ordner wählen, der gesichert werden soll:" default location (POSIX file "/Volumes"))' 2>/dev/null) \
          || { print "Nichts ausgewählt."; return 1; }
      fi
      [[ "$dir" != "/" ]] && dir=${dir%/}
      [[ -d "$dir" ]] || { print "Ordner nicht gefunden: $dir" >&2; return 1; }
      dir=${dir:A}
      # /Volumes/Macintosh HD ist ein Verweis auf "/"
      [[ "$dir" == /Volumes/* && "$(stat -f %d "$dir")" == "$(stat -f %d /)" && "$dir" == /Volumes/*([^/]) ]] && dir="/"
      for id in $(source_ids); do
        load_source "$id"; [[ "$SRC_ROOT" == "$dir" ]] && { print "Schon als Quelle eingerichtet: $SRC_NAME ($id)"; return 0; }
      done
      if [[ -z "$name" ]]; then
        if [[ "$dir" == "/" ]]; then name="Macintosh HD"
        elif [[ "$dir" == /Volumes/* ]]; then name=${${dir#/Volumes/}%%/*}; [[ "$dir" == /Volumes/*/* ]] && name="$name – ${dir:t}"
        else name=${dir:t}; fi
      fi
      id=$(slugify "$name"); local base=$id n=2
      while [[ -d "$SOURCES_DIR/$id" ]]; do id="$base-$n"; (( n++ )); done
      write_source "$id" "$name" "$dir" "$id"
      log "Quelle hinzugefügt: $name ($dir)"
      print "Quelle hinzugefügt: $name  ($dir, ID: $id)"
      [[ "$dir" == "/" ]] && print "  Tipp: Mit 'ssd-backup include add -s $id' nur bestimmte Ordner sichern."
      [[ "$dir" != /Volumes/* ]] && print "  Hinweis: Für interne Ordner braucht /bin/zsh evtl. Festplattenvollzugriff (siehe README)."
      return 0 ;;
    remove|rm)
      load_source "$1" || { print "Unbekannte Quelle: $1  (ssd-backup sources)" >&2; return 1; }
      rm -rf -- "$SOURCES_DIR/$SRC_ID" "$STATE_DIR/sources/$SRC_ID"
      log "Quelle entfernt: $SRC_NAME ($SRC_ROOT)"
      print "Quelle entfernt: $SRC_NAME. Bereits gesicherte Stände bleiben in pCloud erhalten."
      return 0 ;;
    enable|disable)
      load_source "$1" || { print "Unbekannte Quelle: $1" >&2; return 1; }
      write_source "$SRC_ID" "$SRC_NAME" "$SRC_ROOT" "$SRC_TAG" $([[ $action == enable ]] && print 1 || print 0)
      print "$SRC_NAME: $([[ $action == enable ]] && print aktiviert || print deaktiviert)" ;;
    rename)
      load_source "$1" || { print "Unbekannte Quelle: $1" >&2; return 1; }
      [[ -n "$2" ]] || { print "Aufruf: ssd-backup source rename ID NEUER-NAME" >&2; return 1; }
      write_source "$SRC_ID" "$2" "$SRC_ROOT" "$SRC_TAG" "$SRC_ENABLED"
      print "Umbenannt: $2" ;;
    *) print "Unbekannt: $action  (list | add [PFAD] [NAME] | remove ID | enable ID | disable ID | rename ID NAME)"; return 1 ;;
  esac
}

# Alle restic-Aufrufe mit begrenzter Zahl paralleler pCloud-Verbindungen
# (pCloud antwortet bei vielen gleichzeitigen Uploads gern mit Fehler 500)
restic() {
  command restic -o rclone.connections=${RCLONE_CONNECTIONS:-2} "$@"
}

# ---------------------------------------------------------------------------
#  Hilfsfunktionen
# ---------------------------------------------------------------------------
log()    { print -r -- "$(date '+%Y-%m-%d %H:%M:%S')  $*" >> "$LOG_FILE"; }
notify() { (( ${NOTIFICATIONS:-1} )) || return 0; osascript -e "display notification \"$2\" with title \"SSD-Backup\" subtitle \"$1\"" 2>/dev/null; }
now()    { date +%s; }

stamp_age_days() {
  [[ -f "$1" ]] || { echo 999; return; }
  echo $(( ( $(now) - $(cat "$1") ) / 86400 ))
}

hbytes() {   # 1234567 → "1.2 MB"
  local -F b=${1:-0}; local u=(B KB MB GB TB PB) i=1
  while (( b >= 1000 && i < ${#u} )); do (( b /= 1000.0 )); (( i++ )); done
  (( i == 1 )) && printf "%d B" $b || printf "%.1f %s" $b ${u[$i]}
}

hdur() {     # 3725 → "1 Std. 2 Min."
  local s=${1:-0}
  (( s < 60 ))    && { print "${s} Sek."; return; }
  (( s < 3600 ))  && { print "$(( s / 60 )) Min."; return; }
  (( s < 86400 )) && { print "$(( s / 3600 )) Std. $(( s % 3600 / 60 )) Min."; return; }
  print "$(( s / 86400 )) Tg. $(( s % 86400 / 3600 )) Std."
}

hnum() {     # 1234567 → "1'234'567"
  local n=${1:-0} out=""
  n=${n%.*}
  while (( ${#n} > 3 )); do out="'${n: -3}$out"; n=${n:0:-3}; done
  print -r -- "$n$out"
}

# Status als zsh-Assoziativ-Array speichern / laden
typeset -gA S
save_status() {
  S[updated]=$(now)
  print -r -- "typeset -gA S=( ${(@kvqq)S} )" > "$STATUS_FILE.tmp" && mv "$STATUS_FILE.tmp" "$STATUS_FILE"
  # gleicher Inhalt als JSON für die Menüleisten-App
  jq -n '$ARGS.positional as $a | reduce range(0; $a|length; 2) as $i ({}; .[$a[$i]] = $a[$i+1])' \
     --args "${(@kv)S}" > "$STATUS_FILE.json.tmp" 2>/dev/null && mv "$STATUS_FILE.json.tmp" "$STATUS_FILE.json"
}
load_status() { S=(); [[ -f "$STATUS_FILE" ]] && source "$STATUS_FILE"; }

# Aktuellen Status S zusätzlich unter <datei> und <datei>.json ablegen
dump_status() {
  print -r -- "typeset -gA S=( ${(@kvqq)S} )" > "$1"
  jq -n '$ARGS.positional as $a | reduce range(0; $a|length; 2) as $i ({}; .[$a[$i]] = $a[$i+1])' \
     --args "${(@kv)S}" > "$1.json" 2>/dev/null
}

worse() {   # schlechterer von zwei Zuständen
  local -A r=(ok 0 warning 1 error 2)
  (( ${r[$2]:-0} > ${r[$1]:-0} )) && print $2 || print $1
}

# Liste lesen (ohne Kommentare/Leerzeilen, ohne führende/abschließende / )
read_list() {
  local line
  [[ -f "$1" ]] || return
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%[[:space:]]#}"; line="${line##[[:space:]]#}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#/}"; line="${line%/}"
    print -r -- "$line"
  done < "$1"
}

# ---------------------------------------------------------------------------
#  Ordner-Listen verwalten:  ssd-backup include|exclude add|remove|list
# ---------------------------------------------------------------------------
pick_folders() {   # Finder-Dialog, liefert Pfade relativ zur Quelle
  src_present || { print "'$SRC_NAME' ist nicht verfügbar (nicht angesteckt?)." >&2; return 1; }
  osascript <<EOF 2>/dev/null
set picked to choose folder with prompt "Ordner in $SRC_NAME wählen (Mehrfachauswahl mit ⌘):" default location (POSIX file "$SRC_ROOT") with multiple selections allowed
set out to ""
repeat with f in picked
  set out to out & POSIX path of f & linefeed
end repeat
return out
EOF
}

to_relative() {    # absoluter Pfad → relativ zur Quelle (oder unverändert)
  local p="${1%/}" root="${SRC_ROOT:A}"
  [[ "$root" == "/" ]] && root=""
  if [[ "$p" == /* ]]; then
    p="${p:A}"
    [[ "$p" == "$root"/* ]] || { print "Nicht in $SRC_NAME: $1" >&2; return 1; }
    p="${p#$root/}"
  fi
  print -r -- "$p"
}

manage_list() {
  local kind=$1; shift
  if [[ "$1" == (-s|--source) ]]; then select_source "$1" "$2" || return 1; shift 2
  else select_source || return 1; fi
  local action=$1; (( $# )) && shift
  local file; [[ $kind == include ]] && file=$SRC_INCLUDE || file=$SRC_EXCLUDE
  local label; [[ $kind == include ]] && label="Gesicherte Ordner" || label="Ausgeschlossen"
  local -a items current
  current=("${(@f)$(read_list "$file")}"); current=(${current:#})

  case $action in
    add)
      if (( $# )); then items=("$@"); else items=("${(@f)$(pick_folders)}"); fi
      items=(${items:#})
      (( ${#items} )) || { print "Nichts ausgewählt."; return 1; }
      local it rel
      for it in "${items[@]}"; do
        if [[ $kind == exclude && "$it" == *[\*\?\[]* ]]; then rel="$it"
        else rel=$(to_relative "$it") || continue; fi
        if (( ${current[(Ie)$rel]} )); then print "  = $rel (schon in der Liste)"
        else
          print -r -- "$rel" >> "$file"; current+=("$rel"); print "  + $rel"
          [[ "$rel" != *[\*\?\[]* && ! -e "${SRC_ROOT%/}/$rel" ]] && print "    ⚠︎ existiert (noch) nicht in $SRC_NAME"
        fi
      done ;;
    remove|rm)
      (( ${#current} )) || { print "$label: Liste ist leer."; return; }
      if (( ! $# )); then
        local i; for i in {1..${#current}}; do print "  $i) ${current[$i]}"; done
        local ans; read "ans?Nummer(n) zum Entfernen (z. B. 1 3): "
        for i in ${=ans}; do [[ $i == <-> ]] && (( i>=1 && i<=${#current} )) && set -- "$@" "${current[$i]}"; done
      fi
      local it rel tmp="$file.tmp"
      for it in "$@"; do
        rel=$(to_relative "$it" 2>/dev/null) || rel="$it"
        if (( ${current[(Ie)$rel]} )); then
          grep -vxF -- "$rel" "$file" | grep -vxF -- "/$rel" | grep -vxF -- "$rel/" > "$tmp"; mv "$tmp" "$file"
          print "  − $rel"
        else print "  ? $rel ist nicht in der Liste"; fi
      done ;;
    list|"")
      print "$label – $SRC_NAME ($file):"
      if (( ${#current} )); then printf "  • %s\n" "${current[@]}"
      elif [[ $kind == include ]]; then print "  (leer → die ganze Quelle wird gesichert)"
      else print "  (keine eigenen Ausschlüsse)"; fi ;;
    *) print "Unbekannt: $action  (add | remove | list)"; return 1 ;;
  esac
}

# Argumente für restic aus den Listen der aktuellen Quelle bauen
build_backup_args() {
  BACKUP_PATHS=() EXCLUDE_ARGS=()
  local p root=${SRC_ROOT%/}
  for p in "${(@f)$(read_list "$SRC_INCLUDE")}"; do
    [[ -z "$p" ]] && continue
    if [[ -e "$root/$p" ]]; then BACKUP_PATHS+=("$root/$p")
    else log "WARNUNG: Ordner aus include.txt fehlt in $SRC_NAME: $p"; fi
  done
  # Liste gefüllt, aber nichts davon existiert → lieber abbrechen
  [[ -n "$(read_list "$SRC_INCLUDE")" ]] && (( ${#BACKUP_PATHS} == 0 )) && return 1
  (( ${#BACKUP_PATHS} )) || BACKUP_PATHS=("$SRC_ROOT")

  for p in "${SYSTEM_EXCLUDES[@]}"; do EXCLUDE_ARGS+=(--exclude "$p"); done
  [[ "$SRC_ROOT" == "/" ]] && for p in "${ROOT_EXCLUDES[@]}"; do EXCLUDE_ARGS+=(--exclude "$p"); done
  for p in "${(@f)$(read_list "$SRC_EXCLUDE")}"; do
    [[ -z "$p" ]] && continue
    if [[ "$p" == *[\*\?\[]* ]]; then EXCLUDE_ARGS+=(--exclude "$p")
    else EXCLUDE_ARGS+=(--exclude "$root/$p"); fi
  done
  EXCLUDE_ARGS+=(--exclude-if-present .nobackup --exclude-caches)
}

# ---------------------------------------------------------------------------
#  Backup ausführen:  ssd-backup run [--force]
# ---------------------------------------------------------------------------
fail() {
  log "FEHLER: $1"
  load_status; S[state]=error; S[message]="$1"; S[finished]=$(now); save_status
  notify "Fehlgeschlagen" "$1 – Details: ssd-backup log"
  exit 1
}

# Ein restic-Backup mit Fortschrittsanzeige ausführen; Rückgabe = restic-Exitcode
do_backup() {
  local line milestone=0 pct rc
  local -a f
  S[phase]=backup; S[percent]=0; S[eta]=0; save_status
  export RESTIC_PROGRESS_FPS=0.5   # alle 2 s ein Status
  restic backup --json --tag "$SRC_TAG" --group-by host,tags \
      --host "$(scutil --get LocalHostName)" \
      "${EXCLUDE_ARGS[@]}" "${BACKUP_PATHS[@]}" 2>"$STATE_DIR/backup.err" |
  while IFS= read -r line; do
    case $line in
      *'"message_type":"status"'*)
        f=("${(@ps:\t:)$(jq -r '[.percent_done//0, .total_files//0, .files_done//0,
             .total_bytes//0, .bytes_done//0, .seconds_elapsed//0,
             .seconds_remaining//0, ((.current_files//[])[0]//"")] | @tsv' <<<"$line")}")
        S[percent]=$(printf "%.1f" $(( ${f[1]:-0} * 100 )))
        S[total_files]=${f[2]} S[files_done]=${f[3]} S[total_bytes]=${f[4]}
        S[bytes_done]=${f[5]} S[elapsed]=${f[6]} S[eta]=${f[7]} S[current]=${f[8]}
        save_status
        pct=${S[percent]%.*}
        if (( NOTIFY_PROGRESS && pct >= milestone + 25 && pct < 100 )); then
          milestone=$(( pct / 25 * 25 ))
          notify "${milestone} % fertig" "$(hbytes ${S[bytes_done]}) von $(hbytes ${S[total_bytes]}) – noch ca. $(hdur ${S[eta]})"
        fi ;;
      *'"message_type":"summary"'*)
        f=("${(@ps:\t:)$(jq -r '[.files_new, .files_changed, .files_unmodified,
             .data_added, .total_bytes_processed, .total_duration, .snapshot_id//""] | @tsv' <<<"$line")}")
        S[files_new]=${f[1]} S[files_changed]=${f[2]} S[data_added]=${f[4]}
        S[total_bytes]=${f[5]} S[bytes_done]=${f[5]} S[snapshot]=${f[7]} S[percent]=100
        save_status
        log "Fertig: ${f[1]} neue, ${f[2]} geänderte, ${f[3]} unveränderte Dateien; $(hbytes ${f[4]}) hochgeladen; Dauer $(hdur ${f[6]%.*}); Stand ${f[7]:0:8}" ;;
      *'"message_type":"error"'*)
        log "Lesefehler: $(jq -r '(.item // "") + " – " + (.error.message // .error // "" | tostring)' <<<"$line")" ;;
      *'"message_type":"verbose_status"'*) ;;
      *) [[ -n "$line" ]] && print -r -- "$line" >> "$LOG_FILE" ;;
    esac
  done
  rc=${pipestatus[1]}   # (nicht "local rc=…" – das setzt pipestatus zurück)
  cat "$STATE_DIR/backup.err" >> "$LOG_FILE" 2>/dev/null
  # Exit 3 nur wegen "storing the file again" (Daten nach Reparatur neu hochgeladen)
  # ist kein Lesefehler – das Backup ist vollständig.
  if (( rc == 3 )); then
    grep '"message_type":"error"' "$STATE_DIR/backup.err" 2>/dev/null \
      | grep -qv 'storing the file again' || rc=0
  fi
  return $rc
}

# Schnelle Strukturprüfung: sind alle Dateien auf pCloud vollständig?
# Rückgabe 0 = ok, 1 = beschädigte Pakete (IDs in DAMAGED_PACKS), 2 = anderer Fehler,
#          4 = gesperrt (z. B. weil das Backup gerade im Finder eingehängt ist)
verify_repo() {
  local out="$STATE_DIR/check.out"
  S[phase]=verify; save_status
  log "Schnellprüfung (Vollständigkeit auf pCloud)"
  restic check "$@" > "$out" 2>&1
  local rc=$?
  grep -v 'NOTICE: Config' "$out" | grep -vE '^\[[0-9:]+\]' >> "$LOG_FILE"
  (( rc == 0 )) && return 0
  if grep -q "repository is already locked" "$out"; then
    # Sperren abgestürzter/beendeter Vorgänge entfernen und einmal neu versuchen
    if (( ! VERIFY_RETRIED )) && remove_stale_locks; then
      local VERIFY_RETRIED=1; verify_repo "$@"; return $?
    fi
    return 4
  fi
  local p; DAMAGED_PACKS=()
  for p in ${=$(sed -n 's/^restic repair packs //p' "$out" | head -1)}; do
    [[ $p =~ '^[0-9a-f]{64}$' ]] && DAMAGED_PACKS+=($p)
  done
  (( ${#DAMAGED_PACKS} )) && return 1
  return 2
}

# repair packs legt Sicherungskopien im aktuellen Ordner ab (unter launchd "/" = schreibgeschützt)
repair_packs() {
  local dir="$STATE_DIR/repair-copies"; mkdir -p "$dir"
  ( cd "$dir" && restic repair packs "${DAMAGED_PACKS[@]}" )
}

# Beschädigte Pakete entfernen und fehlende Daten neu hochladen
repair_repo() {
  log "REPARATUR: ${#DAMAGED_PACKS} beschädigte Pakete auf pCloud werden entfernt"
  notify "Reparatur" "${#DAMAGED_PACKS} beschädigte Pakete auf pCloud – lade neu hoch"
  S[phase]=repair; save_status
  repair_packs >> "$LOG_FILE" 2>&1 || return 1
  log "REPARATUR: fehlende Daten erneut hochladen"
  local id rc
  for id in "${DONE_IDS[@]}"; do
    load_source "$id" && src_present && build_backup_args || continue
    S[source]=$SRC_ID S[source_name]=$SRC_NAME S[source_root]=$SRC_ROOT
    do_backup; rc=$?
    src_present || return 3
    (( rc == 0 || rc == 3 )) || return 1
  done
  verify_repo; local v=$?
  (( v == 0 )) || return 1
  log "REPARATUR erfolgreich"
  return 0
}

# Entfernt nur verwaiste Sperren (Prozess beendet/abgestürzt), nie die eines
# laufenden Vorgangs. Rückgabe 0, wenn etwas entfernt wurde.
remove_stale_locks() {
  local out; out=$(restic unlock 2>&1)
  print -r -- "$out" >> "$LOG_FILE"
  [[ "$out" =~ 'removed [1-9][0-9]* locks?' ]]
}

backup_is_mounted() { mount | grep -q '^restic.* (macfuse'; }

locked_msg() {
  if backup_is_mounted; then
    print -r -- "Backup ist im Finder eingehängt (Durchstöbern) – Prüfung/Reparatur wartet bis zum Aushängen (⏏︎ in der App)."
  else
    print -r -- "pCloud-Backup ist durch einen anderen restic-Vorgang gesperrt – nächster Versuch in 1 Std."
  fi
}

cmd_run() {
  local force=0; local -a only=()
  if [[ "$1" == "--force" ]]; then force=1; shift; only=("$@"); fi
  # von der App angefordert ("Backup starten"), evtl. nur für bestimmte Quellen
  if [[ -f "$STATE_DIR/force_next" ]]; then
    force=1; only=("${(@f)$(<"$STATE_DIR/force_next")}"); only=(${only:#}); rm -f "$STATE_DIR/force_next"
  fi

  if (( ! force )); then
    # Direkt nach "schedule apply" startet launchd uns einmal – das ist kein echter Auslöser
    [[ -f "$STATE_DIR/schedule_applied" ]] && (( $(now) - $(<"$STATE_DIR/schedule_applied") < 90 )) && exit 0
    # Automatik pausiert? (manueller Start geht trotzdem)
    [[ -f "$STATE_DIR/paused" ]] && exit 0
  fi

  # --- fällige Quellen bestimmen -------------------------------------------
  # launchd startet uns bei JEDEM eingehängten Laufwerk und stündlich → meist still beenden
  local -a due=(); local id
  for id in $(source_ids); do
    load_source "$id" || continue
    if (( ${#only} )); then (( ${only[(Ie)$id]} )) || continue
    else (( SRC_ENABLED )) || continue; fi
    src_present || continue
    # Mindestabstand je Quelle – außer eine Reparatur steht noch aus
    if (( ! force )) && [[ ! -f "$STATE_DIR/needs_repair" && -f "$SRC_STATE/last_success" ]]; then
      (( ( $(now) - $(<"$SRC_STATE/last_success") ) / 3600 < MIN_HOURS_BETWEEN )) && continue
    fi
    due+=("$id")
  done

  # Nichts fällig: höchstens eine (wegen Einhängen) übersprungene Prüfung nachholen
  local check_only=0
  if (( ! ${#due} )); then
    if (( force )); then
      print "Keine der gewählten Quellen ist gerade verfügbar (nicht angesteckt oder deaktiviert)."
      exit 1
    fi
    [[ -f "$STATE_DIR/needs_check" ]] || exit 0
    backup_is_mounted && exit 0      # immer noch eingehängt → später
    check_only=1
  fi

  # Nur ein Lauf gleichzeitig
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local oldpid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if [[ -n "$oldpid" ]] && kill -0 "$oldpid" 2>/dev/null; then
      (( force )) && print "Es läuft bereits ein Backup – Fortschritt: ssd-backup status -w"
      exit 0
    fi
    rm -rf "$LOCK_DIR"; mkdir "$LOCK_DIR"
  fi
  print $$ > "$LOCK_DIR/pid"
  trap 'rm -rf "$LOCK_DIR"' EXIT
  trap 'pkill -TERM -P $$ 2>/dev/null; load_status; S[state]=error; S[message]="Abgebrochen"; S[finished]=$(now); save_status; log "Abgebrochen"; exit 130' INT TERM HUP

  command -v restic >/dev/null || fail "restic nicht gefunden (brew install restic)"
  command -v rclone >/dev/null || fail "rclone nicht gefunden (brew install rclone)"
  command -v jq     >/dev/null || fail "jq nicht gefunden (brew install jq)"

  (( force || check_only )) || sleep 15        # Laufwerk nach dem Einstecken kurz ankommen lassen

  # Mac wach halten, solange dieser Lauf dauert
  caffeinate -i -w $$ &!

  local -a names=(); for id in $due; do load_source "$id"; names+=("$SRC_NAME"); done
  S=(state running phase connect started $(now) pid $$ percent 0 sources_total ${#due} sources "${(j:, :)names}")
  save_status
  (( check_only )) || log "=== Backup gestartet: ${(j:, :)names} → $RESTIC_REPOSITORY"

  local i
  for i in {1..5}; do
    restic cat config >/dev/null 2>>"$LOG_FILE" && break
    (( i == 5 )) && fail "pCloud-Repository nicht erreichbar (Internet? Passwort?)"
    sleep 60
  done
  remove_stale_locks >/dev/null

  # --- nur die übersprungene Prüfung nachholen (kein neues Backup) --------
  if (( check_only )); then
    log "Übersprungene Prüfung wird nachgeholt"
    verify_repo; local v=$?
    if (( v == 0 || v == 4 )); then
      (( v == 0 )) && rm -f "$STATE_DIR/needs_check"
      # Anzeige wieder auf den letzten Lauf setzen
      S=(); [[ -f "$STATE_DIR/last_run" ]] && source "$STATE_DIR/last_run"
      (( v == 0 )) && [[ ${S[state]} == warning ]] && { S[state]=ok; S[message]=""; }
      save_status
      (( v == 0 )) && dump_status "$STATE_DIR/last_run"
      log "=== Prüfung $( (( v == 0 )) && print ok || print 'weiterhin gesperrt' )"
      exit 0
    fi
    # Probleme gefunden → Reparatur mit allen verfügbaren Quellen
    rm -f "$STATE_DIR/needs_check"; touch "$STATE_DIR/needs_repair"
    for id in $(source_ids); do load_source "$id" && (( SRC_ENABLED )) && src_present && due+=("$id"); done
    (( ${#due} )) || fail "Backup auf pCloud beschädigt – Reparatur, sobald eine Quelle verfügbar ist"
  fi

  # --- ausstehende Reparatur aus einem früheren Lauf zuerst erledigen -----
  if [[ -f "$STATE_DIR/needs_repair" ]]; then
    log "Ausstehende Reparatur aus früherem Lauf"
    verify_repo; local v=$?
    if (( v == 1 )); then
      log "REPARATUR: ${#DAMAGED_PACKS} beschädigte Pakete werden entfernt (rettet vorher, was noch lesbar ist)"
      S[phase]=repair; save_status
      repair_packs >> "$LOG_FILE" 2>&1 \
        || fail "Reparatur (repair packs) fehlgeschlagen"
      log "Beschädigte Pakete entfernt – die folgenden Backups laden die Daten neu hoch"
    elif (( v == 4 )); then
      # Backup selbst geht auch bei eingehängtem Backup – Reparatur später
      log "WARNUNG: $(locked_msg) Normales Backup läuft trotzdem."
    elif (( v == 2 )); then
      fail "Prüfung meldet Fehler, die nicht automatisch reparierbar sind – siehe Log"
    fi
  fi

  # --- Backup jeder fälligen Quelle ------------------------------------------
  local overall=ok rc n=0 k
  local -a msgs=(); typeset -ga DONE_IDS=()
  for id in $due; do
    (( n++ )); load_source "$id"
    for k in total_files files_done total_bytes bytes_done eta current elapsed files_new files_changed data_added snapshot; do
      unset "S[$k]"
    done
    S[source]=$SRC_ID S[source_name]=$SRC_NAME S[source_root]=$SRC_ROOT S[source_index]=$n S[state]=running
    save_status
    if ! src_present; then
      source_result warning "Nicht mehr verfügbar – wird beim nächsten Mal gesichert" 0
      continue
    fi
    if ! build_backup_args; then
      source_result error "Keiner der Ordner aus der Liste existiert"
      continue
    fi
    log "--- $SRC_NAME ($n/${#due}): ${(j:, :)BACKUP_PATHS}"
    notify "Läuft" "Backup von $SRC_NAME nach pCloud gestartet"

    do_backup; rc=$?

    # Platte während des Backups abgezogen? Dann ist der Stand unvollständig.
    if ! src_present; then
      source_result warning "Während des Backups entfernt – wird beim nächsten Einstecken fortgesetzt" 0
    elif (( rc == 3 )); then
      log "WARNUNG ($SRC_NAME): einige Dateien konnten nicht gelesen werden (siehe oben)"
      source_result warning "Einige Dateien wurden übersprungen"
    elif (( rc != 0 )); then
      source_result error "restic backup beendet mit Code $rc"
    else
      source_result ok ""
    fi
  done
  S[source]="" S[source_name]="" S[source_index]=""

  (( ${#DONE_IDS} )) || fail "${(j:; :)msgs}"
  local final_state=$overall final_msg="${(j:; :)msgs}"

  # --- Schnellprüfung, bei Bedarf automatisch reparieren --------------------
  verify_repo; local v=$?
  if (( v == 1 )); then
    touch "$STATE_DIR/needs_repair"
    repair_repo; local r=$?
    (( r == 3 )) && fail "Quelle wurde während der Reparatur entfernt – wird beim nächsten Mal fortgesetzt"
    (( r != 0 )) && fail "Backup auf pCloud beschädigt, Reparatur fehlgeschlagen – nächster Versuch in 1 Std."
  elif (( v == 4 )); then
    # Backup selbst ist durch – nur die Prüfung holen wir nach dem Aushängen nach
    touch "$STATE_DIR/needs_check"
    log "WARNUNG: $(locked_msg)"
    final_state=$(worse $final_state warning)
    final_msg="${final_msg:+$final_msg; }Prüfung übersprungen: $(locked_msg)"
  elif (( v == 2 )); then
    touch "$STATE_DIR/needs_repair"
    fail "Prüfung meldet Fehler, die nicht automatisch reparierbar sind – siehe Log"
  fi
  (( v == 4 )) || rm -f "$STATE_DIR/needs_repair" "$STATE_DIR/needs_check"
  date +%s > "$STATE_DIR/last_success"

  # --- Aufräumen (gilt für alle Quellen, je Stichwort getrennt) -----------
  local -a forget_args=(--group-by host,tags
      --keep-daily $KEEP_DAILY --keep-weekly $KEEP_WEEKLY
      --keep-monthly $KEEP_MONTHLY --keep-yearly $KEEP_YEARLY)
  S[state]=running; S[phase]=cleanup; save_status
  if (( v == 4 )); then
    log "Aufräumen übersprungen (Backup ist eingehängt)"
  elif (( $(stamp_age_days "$STATE_DIR/last_prune") >= PRUNE_EVERY_DAYS )); then
    log "Alte Stände entfernen + prune"
    restic forget "${forget_args[@]}" --prune >> "$LOG_FILE" 2>&1 \
      && date +%s > "$STATE_DIR/last_prune" || log "WARNUNG: forget/prune fehlgeschlagen"
  else
    restic forget "${forget_args[@]}" >> "$LOG_FILE" 2>&1 || log "WARNUNG: forget fehlgeschlagen"
  fi

  # --- Integritätsprüfung mit Lesen der Daten (Stichprobe 5 %) --------------
  if (( v != 4 && $(stamp_age_days "$STATE_DIR/last_check") >= CHECK_EVERY_DAYS )); then
    S[phase]=check; save_status
    log "Integritätsprüfung (Stichprobe 5 %)"
    if restic check --read-data-subset=5% >> "$LOG_FILE" 2>&1; then
      date +%s > "$STATE_DIR/last_check"
    else
      touch "$STATE_DIR/needs_repair"
      fail "Integritätsprüfung hat Probleme gefunden – Reparatur beim nächsten Lauf"
    fi
  fi

  S[state]=$final_state; S[message]=$final_msg; S[phase]=done; S[finished]=$(now); S[percent]=100
  save_status
  dump_status "$STATE_DIR/last_run"
  log "=== Backup beendet ($final_state)"
  if [[ $final_state == ok ]]; then
    notify "Erfolgreich" "${S[sources]} gesichert – Dauer $(hdur $(( S[finished] - S[started] )))"
  else
    notify "Mit Warnungen fertig" "${S[message]} – siehe: ssd-backup log"
  fi
}

# Ergebnis der aktuellen Quelle festhalten (je Quelle + Gesamtzustand)
source_result() {   # source_result ok|warning|error MELDUNG [ERFOLG=1]
  local st=$1 msg=$2 success=${3:-1}
  [[ $st == error ]] && success=0
  [[ $st == error ]] && log "FEHLER ($SRC_NAME): $msg"
  overall=$(worse $overall $st)
  [[ -n "$msg" ]] && msgs+=("$SRC_NAME: $msg")
  local -A keep; keep=("${(@kv)S}")
  S[state]=$st S[message]=$msg S[finished]=$(now) S[phase]=done
  dump_status "$SRC_STATE/last_run"
  S=("${(@kv)keep}")
  if (( success )); then
    date +%s > "$SRC_STATE/last_success"
    DONE_IDS+=("$SRC_ID")
  fi
}

# ---------------------------------------------------------------------------
#  Statusanzeige:  ssd-backup status [-w]
# ---------------------------------------------------------------------------
bar() {
  local -i w=30 n=$(( ${1%.*} * 30 / 100 ))
  (( n > w )) && n=w
  local s=""
  repeat $n s+="█"
  repeat $(( w - n )) s+="░"
  print -rn -- "$s"
}

print_status() {
  load_status
  local B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' G=$'\e[32m' Y=$'\e[33m' E=$'\e[31m' C=$'\e[36m'
  print "${B}SSD-Backup${R}  ${D}→ pCloud:$REPO_PATH${R}\n"

  local state=${S[state]:-none}
  # läuft laut Datei, aber Prozess ist weg → abgebrochen
  if [[ $state == running ]] && ! kill -0 ${S[pid]:-0} 2>/dev/null; then
    state=error; S[message]="Abgebrochen (Mac ausgeschaltet/Platte entfernt?)"
  fi

  case $state in
    running)
      local phase
      case ${S[phase]} in
        connect) phase="Verbinde mit pCloud …" ;;
        backup)  phase="Sichere Dateien" ;;
        cleanup) phase="Räume alte Stände auf" ;;
        check)   phase="Prüfe Backup (Stichprobe)" ;;
        verify)  phase="Prüfe Vollständigkeit auf pCloud" ;;
        repair)  phase="Repariere beschädigte Daten auf pCloud" ;;
        *)       phase=${S[phase]} ;;
      esac
      print "  Zustand      ${C}● läuft${R} – $phase  ${D}(seit $(hdur $(( $(now) - S[started] ))))${R}"
      [[ -n ${S[source_name]} ]] && print "  Quelle       ${B}${S[source_name]}${R}  ${D}(${S[source_index]} von ${S[sources_total]})${R}"
      if [[ ${S[phase]} == backup && -n ${S[total_bytes]} ]]; then
        print "  Fortschritt  ${C}$(bar ${S[percent]})${R}  ${B}${S[percent]} %${R}"
        print "  Daten        $(hbytes ${S[bytes_done]}) von $(hbytes ${S[total_bytes]})"
        print "  Dateien      $(hnum ${S[files_done]}) von $(hnum ${S[total_files]})"
        (( ${S[eta]:-0} > 0 )) && print "  Restzeit     ca. $(hdur ${S[eta]})"
        if [[ -n ${S[current]} ]]; then
          local cur=${S[current]#${S[source_root]%/}/}
          (( ${#cur} > 60 )) && cur="…${cur: -59}"
          print "  Aktuell      ${D}$cur${R}"
        fi
        (( ${S[elapsed]:-0} < 300 && ${S[percent]%.*} < 5 )) && \
          print "  ${D}(Am Anfang zählt restic noch Dateien – die Prozentzahl wird genauer.)${R}"
      fi ;;
    ok)      print "  Zustand      ${G}✓ letzter Lauf erfolgreich${R}" ;;
    warning) print "  Zustand      ${Y}⚠ fertig mit Warnungen${R} – ${S[message]}" ;;
    error)   print "  Zustand      ${E}✗ Fehler${R} – ${S[message]}" ;;
    *)       print "  Zustand      ${D}noch kein Backup gelaufen${R}" ;;
  esac

  print "\n  ${B}Quellen${R}"
  local id dot avail inc exc scope last warn ts; local -a ids; ids=($(source_ids))
  local -A L
  (( ${#ids} )) || print "  ${D}keine – hinzufügen mit: ssd-backup source add${R}"
  for id in $ids; do
    load_source "$id"
    if src_present; then dot="${G}●${R}"; src_external && avail="angesteckt" || avail="intern"
    else dot="${D}○${R}"; src_external && avail="nicht angesteckt" || avail="nicht gefunden"; fi
    (( SRC_ENABLED )) || avail="$avail, deaktiviert"
    inc=$(read_list "$SRC_INCLUDE" | wc -l | tr -d ' ')
    exc=$(read_list "$SRC_EXCLUDE" | wc -l | tr -d ' ')
    (( inc )) && scope="$inc Ordner" || scope="alles"; (( exc )) && scope+=", $exc Ausschlüsse"
    last="${D}noch nie gesichert${R}" warn=""
    if [[ -f "$SRC_STATE/last_success" ]]; then
      ts=$(<"$SRC_STATE/last_success")
      last="zuletzt $(date -r $ts '+%d.%m.%Y %H:%M') ${D}(vor $(hdur $(( $(now) - ts ))))${R}"
      (( ( $(now) - ts ) / 86400 >= 7 )) && warn="  ${Y}⚠ über 7 Tage alt${R}"
    fi
    print "  $dot ${B}$SRC_NAME${R}  ${D}$SRC_ROOT · $avail · $scope${R}"
    print "      $last$warn"
    if [[ -f "$SRC_STATE/last_run" ]]; then
      L=("${(@kv)S}"); source "$SRC_STATE/last_run"
      [[ ${S[state]} == (warning|error) && -n ${S[message]} ]] && print "      ${Y}${S[message]}${R}"
      S=("${(@kv)L}")
    fi
  done
}

cmd_status() {
  if [[ "$1" == "-w" || "$1" == "--watch" ]]; then
    trap 'tput cnorm; print; exit 0' INT
    tput civis
    while true; do
      local out; out=$(print_status)
      clear; print -r -- "$out"; print $'\n  \e[2mAktualisiert alle 2 s – Beenden mit Ctrl-C\e[0m'
      sleep 2
    done
  else
    print_status
  fi
}

# ---------------------------------------------------------------------------
#  Einstellungen ändern & Zeitplan (launchd) anwenden
# ---------------------------------------------------------------------------
SETTABLE_KEYS=(MIN_HOURS_BETWEEN KEEP_DAILY KEEP_WEEKLY KEEP_MONTHLY KEEP_YEARLY
  PRUNE_EVERY_DAYS CHECK_EVERY_DAYS NOTIFICATIONS NOTIFY_PROGRESS RCLONE_CONNECTIONS
  RUN_ON_MOUNT SCHEDULE INTERVAL_HOURS DAILY_TIME)

cmd_set() {   # ssd-backup set KEY WERT [KEY WERT …]
  (( $# >= 2 && $# % 2 == 0 )) || { print "Aufruf: ssd-backup set SCHLÜSSEL WERT …" >&2; return 1; }
  while (( $# )); do
    local k=$1 v=$2; shift 2
    (( ${SETTABLE_KEYS[(Ie)$k]} )) || { print "Unbekannte Einstellung: $k" >&2; return 1; }
    case $k in
      SCHEDULE)   [[ $v == (interval|daily|none) ]] ;;
      DAILY_TIME) [[ $v =~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' ]] ;;
      *)          [[ $v == <-> ]] ;;
    esac || { print "Ungültiger Wert für $k: $v" >&2; return 1; }
    if grep -q "^$k=" "$SETTINGS"; then
      local tmp="$SETTINGS.tmp"
      awk -v k="$k" -v v="$v" 'BEGIN{FS="="} $1==k {sub(/=[^#]*/, "=\"" v "\"   "); print; next} {print}' "$SETTINGS" > "$tmp" \
        && mv "$tmp" "$SETTINGS"
    else
      print -r -- "$k=\"$v\"" >> "$SETTINGS"
    fi
  done
  source "$SETTINGS"
}

schedule_text() {
  local t=()
  (( RUN_ON_MOUNT )) && t+=("beim Einstecken")
  case $SCHEDULE in
    interval) (( INTERVAL_HOURS == 1 )) && t+=("stündlich") || t+=("alle $INTERVAL_HOURS Std.") ;;
    daily)    t+=("täglich um $DAILY_TIME") ;;
  esac
  (( ${#t} )) || t=("nur manuell")
  print -r -- "${(j: + :)t}, höchstens alle $MIN_HOURS_BETWEEN Std."
}

cmd_schedule() {
  if [[ "$1" != apply ]]; then print -r -- "Zeitplan: $(schedule_text)"; return; fi
  local label=com.user.ssd-backup plist="$HOME/Library/LaunchAgents/com.user.ssd-backup.plist" trig=""
  (( RUN_ON_MOUNT )) && trig+="  <key>StartOnMount</key>       <true/>"$'\n'
  case $SCHEDULE in
    interval) trig+="  <key>StartInterval</key>      <integer>$(( ${INTERVAL_HOURS:-1} * 3600 ))</integer>"$'\n' ;;
    daily)    trig+="  <key>StartCalendarInterval</key> <dict><key>Hour</key><integer>$(( 10#${DAILY_TIME%%:*} ))</integer><key>Minute</key><integer>$(( 10#${DAILY_TIME##*:} ))</integer></dict>"$'\n' ;;
  esac
  mkdir -p "${plist:h}"
  cat > "$plist.tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>$HOME/bin/ssd-backup</string>
    <string>run</string>
  </array>
${trig}  <key>LowPriorityIO</key>      <true/>
  <key>Nice</key>               <integer>10</integer>
  <key>StandardOutPath</key>    <string>$LOG_FILE</string>
  <key>StandardErrorPath</key>  <string>$LOG_FILE</string>
</dict>
</plist>
PLIST
  plutil -lint "$plist.tmp" >/dev/null || { rm -f "$plist.tmp"; print "Zeitplan ungültig" >&2; return 1; }
  mv "$plist.tmp" "$plist"
  [[ -n "$SCHEDULE_NO_LOAD" ]] && return 0
  # launchd startet den Job beim Laden sofort einmal – diesen Lauf überspringen
  now > "$STATE_DIR/schedule_applied"
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$plist" || { print "launchd: Laden fehlgeschlagen" >&2; return 1; }
  log "Zeitplan geändert: $(schedule_text)"
  print -r -- "Zeitplan aktiv: $(schedule_text)"
}

# ---------------------------------------------------------------------------
#  Hilfe & Dispatcher
# ---------------------------------------------------------------------------
# Backup im Finder einhängen. Fehler landen im Protokoll und in mount.err
# (die App zeigt die letzte Zeile davon an).
cmd_browse() {
  local mp="${1:-$HOME/restic-mount}" err="$STATE_DIR/mount.err" rc
  mkdir -p "$STATE_DIR"; : > "$err"
  if [[ ! -d /Library/Filesystems/macfuse.fs ]]; then
    print -r -- "macFUSE ist nicht installiert – zum Durchstöbern nötig: brew install --cask macfuse (danach Systemerweiterung erlauben und neu starten)" | tee "$err" >&2
    log "Einhängen: macFUSE fehlt"; return 1
  fi
  if ! mkdir -p "$mp" 2>>"$err"; then
    log "Einhängen: Ordner $mp nicht anlegbar: $(tail -n1 "$err")"; cat "$err" >&2; return 1
  fi
  log "Einhängen nach $mp …"
  command restic -o rclone.connections=${RCLONE_CONNECTIONS:-2} mount "$mp" 2>>"$err"; rc=$?
  if (( rc )); then
    log "Einhängen fehlgeschlagen (Exit $rc):"; sed 's/^/    /' "$err" >> "$LOG_FILE"; cat "$err" >&2
  else
    log "Backup ausgehängt."
  fi
  return $rc
}

cmd_help() {
  cat <<'EOF'
ssd-backup – verschlüsseltes Backup von Platten/Ordnern nach pCloud

  ssd-backup status            aktuellen Stand anzeigen
  ssd-backup status -w         live mitverfolgen (Ctrl-C beendet)
  ssd-backup run --force [ID …]  Backup sofort starten (in diesem Terminal)
  ssd-backup start [ID …]      Backup sofort im Hintergrund starten (ohne ID: alle verfügbaren)
  ssd-backup stop              laufendes Backup abbrechen
  ssd-backup pause | resume    Automatik pausieren / wieder aktivieren
  ssd-backup browse            Backup im Finder einhängen (~/restic-mount)

  ssd-backup sources           alle Quellen (Platten/Ordner) anzeigen
  ssd-backup source add [PFAD] [NAME]   Platte oder Ordner hinzufügen (ohne Pfad: Finder-Dialog)
  ssd-backup source remove ID           Quelle entfernen (Stände in pCloud bleiben)
  ssd-backup source enable|disable ID   Quelle (de)aktivieren
  ssd-backup source rename ID NAME

  Ordnerlisten gelten je Quelle – mit -s ID wählen (sonst die erste):
  ssd-backup include [-s ID] add [ORDNER …]   Ordner sichern (ohne Angabe: Finder-Dialog)
  ssd-backup include remove [ORDNER]  aus der Liste nehmen (ohne Angabe: Auswahl)
  ssd-backup exclude add [ORDNER|MUSTER …]   Ordner/Muster ausschließen
  ssd-backup exclude remove [ORDNER]
  ssd-backup lists             beide Listen anzeigen
  ssd-backup edit              Einstellungen + Listen im Texteditor öffnen
  ssd-backup set KEY WERT      Einstellung ändern, z. B.: set SCHEDULE daily DAILY_TIME 03:00
  ssd-backup schedule [apply]  Zeitplan anzeigen / nach Änderung aktivieren

  ssd-backup snapshots         alle gesicherten Stände
  ssd-backup log               Protokoll live ansehen
  ssd-backup restic …          beliebiger restic-Befehl mit dem Backup,
                               z. B.: ssd-backup restic restore latest --target ~/Desktop/restore --include "/Volumes/…/Fotos"

Ist include leer, wird die ganze Quelle gesichert. Eine Datei ".nobackup"
in einem Ordner schließt diesen Ordner ebenfalls aus.
EOF
}

ensure_config
cmd=${1:-status}; (( $# )) && shift
case $cmd in
  run)                cmd_run "$@" ;;
  status|st)          cmd_status "$@" ;;
  include|inc)        manage_list include "$@" ;;
  exclude|exc)        manage_list exclude "$@" ;;
  lists)              for _id in $(source_ids); do manage_list include -s "$_id" list; manage_list exclude -s "$_id" list; print; done ;;
  sources)            cmd_source list ;;
  source|src)         cmd_source "$@" ;;
  edit)               open -t "$SETTINGS" "$SOURCES_DIR"/*/source.conf(N) "$SOURCES_DIR"/*/include.txt(N) "$SOURCES_DIR"/*/exclude.txt(N) ;;
  snapshots|snap)     restic snapshots ;;
  log)                tail -n 40 -f "$LOG_FILE" ;;
  restic)             restic "$@" ;;
  start)              # Backup über launchd starten (läuft unabhängig vom Terminal/der App)
                      print -rl -- "$@" > "$STATE_DIR/force_next"
                      launchctl kickstart "gui/$(id -u)/com.user.ssd-backup" ;;
  stop)               pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
                      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                        kill -TERM "$pid" && print "Backup wird abgebrochen."
                      else print "Es läuft kein Backup."; fi ;;
  pause)              touch "$STATE_DIR/paused"; print "Automatik pausiert (manueller Start geht weiterhin)." ;;
  resume)             rm -f "$STATE_DIR/paused"; print "Automatik wieder aktiv." ;;
  browse|mount)       cmd_browse "$@" ;;
  set)                cmd_set "$@" ;;
  schedule)           cmd_schedule "$@" ;;
  help|-h|--help)     cmd_help ;;
  --force)            cmd_run --force ;;   # Kompatibilität mit altem Aufruf
  *)                  print "Unbekannter Befehl: $cmd\n"; cmd_help; exit 1 ;;
esac
